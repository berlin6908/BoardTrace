<Window x:Class="BoardTrace.Station.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BoardTrace · 回放检测工位" Width="1360" Height="920" MinWidth="1060" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#F2F5F7" Foreground="#203342" FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="#142D38" Padding="25,14">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="退出 / 换班" Command="{Binding SignOutCommand}" Margin="20,0,0,0" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StationId}" Foreground="White" FontSize="16" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding InspectionMode}" Foreground="#A5CBCB" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding OperatorName}" Foreground="White" VerticalAlignment="Center" FontSize="14" Margin="0,0,24,0" />
                <StackPanel>
                    <TextBlock Text="BoardTrace" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="PCB 视觉检测与质量追溯" Foreground="#A5CBCB" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="252" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="14" /><RowDefinition Height="180" /></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="{Binding ActiveBatchNumber}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding BatchStateText}" FontWeight="SemiBold" Foreground="#087F82" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding BatchProgress}" FontSize="11" Foreground="#687B86" TextWrapping="Wrap" Margin="0,0,0,16" />
                        <StackPanel IsEnabled="{Binding CanEdit}">
                            <TextBlock Text="输入样本" Margin="0,0,0,7" />
                            <ComboBox ItemsSource="{Binding Samples}" SelectedItem="{Binding SelectedSample}" DisplayMemberPath="SampleId"
                                      Height="36" AutomationProperties.Name="输入样本" IsTextSearchEnabled="True" />
                            <TextBlock Text="模拟产品编号" Margin="0,18,0,7" />
                            <TextBox Text="{Binding ProductId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="模拟产品编号" />
                            <CheckBox IsChecked="{Binding ConstructedNormal}" Content="使用参考图构造正常输入" Margin="0,18,0,8" />
                            <TextBlock Text="构造输入只验证流程，不代表真实良品。" TextWrapping="Wrap" FontSize="11" Foreground="#687B86" />
                        </StackPanel>
                        <Button Content="{Binding RunButtonText}" Command="{Binding RunCommand}" Background="#087F82" Foreground="White" FontWeight="SemiBold" Margin="0,22,0,0" />
                        <Expander x:Name="BatchExpander" Header="批次下载与启动" Margin="0,14,0,0">
                            <StackPanel Margin="0,10,0,0">
                                <Button Content="刷新本工位批次" Command="{Binding RefreshBatchesCommand}" />
                                <ComboBox ItemsSource="{Binding AssignedBatches}" SelectedItem="{Binding SelectedBatch}" DisplayMemberPath="Label"
                                          IsEnabled="{Binding CanEdit}" AutomationProperties.Name="本工位批次" Height="36" Margin="0,8,0,0" />
                                <Button Content="下载并加载批次" Command="{Binding DownloadBatchCommand}" Margin="0,8,0,0" />
                                <Button Content="刷新当前批次批准" Command="{Binding RefreshActiveBatchCommand}" Margin="0,8,0,0" />
                                <Button Content="本班在线启动" Command="{Binding StartBatchCommand}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding BatchNotice}" TextWrapping="Wrap" FontSize="11" Foreground="#687B86" Margin="0,8,0,0" />
                            </StackPanel>
                        </Expander>
                        <Separator Margin="0,20,0,14" Background="#DFE7EB" />
                        <TextBlock Text="当前方案" FontSize="11" Foreground="#687B86" />
                        <TextBlock Text="{Binding ActiveRecipeName}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ActiveRecipeIdentity}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11" Foreground="#687B86" />
                        <Expander x:Name="RecipeExpander" Header="工程方案选择" Margin="0,14,0,0">
                            <StackPanel Margin="0,10,0,0">
                                <Button Content="刷新已发布版本" Command="{Binding RefreshRecipesCommand}" />
                                <ComboBox ItemsSource="{Binding PublishedRecipes}" SelectedItem="{Binding SelectedRecipe}" DisplayMemberPath="Label"
                                          IsEnabled="{Binding CanEdit}" AutomationProperties.Name="已发布方案" Height="36" Margin="0,8,0,0" />
                                <Button Content="下载并使用" Command="{Binding DownloadRecipeCommand}" Margin="0,8,0,0" />
                                <Button Content="使用本地缓存" Command="{Binding LoadCachedRecipeCommand}" Margin="0,8,0,0" />
                                <Button Content="使用开发参数" Command="{Binding UseDevelopmentRecipeCommand}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding RecipeNotice}" TextWrapping="Wrap" FontSize="11" Foreground="#687B86" Margin="0,8,0,0" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    </ScrollViewer>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="工位事件" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.Template><ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate></ItemsControl.Template>
                            <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#506775" /></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="*" /><RowDefinition Height="14" /><RowDefinition Height="200" /></Grid.RowDefinitions>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="质量判定" FontSize="11" /><TextBlock Text="{Binding Decision}" Foreground="{Binding DecisionBrush}" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="缺陷区域" FontSize="11" /><TextBlock Text="{Binding DefectCount}" FontSize="25" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="检测耗时" FontSize="11" /><TextBlock Text="{Binding DetectionTime}" FontSize="25" Margin="0,5,0,0" /></StackPanel></Border>
                        <Border Grid.Column="3" Style="{StaticResource Card}"><StackPanel><TextBlock Text="待上传" FontSize="11" /><TextBlock Text="{Binding PendingCount}" FontSize="25" Margin="0,5,0,0" /></StackPanel></Border>
                    </Grid>
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="2,14,0,4" />
                    <TextBlock Text="{Binding Notice}" Foreground="#647B89" TextWrapping="Wrap" FontSize="12" Margin="2,0,0,0" />
                    <TextBlock Foreground="#506775" FontSize="12" Margin="2,7,0,0" ToolTip="{Binding ServerAddress}">
                        <Run Text="中央同步 · " /><Run Text="{Binding UploadStatus, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Text="{Binding UploadNotice}" Foreground="#647B89" TextWrapping="Wrap" FontSize="11" Margin="2,3,0,0" />
                </StackPanel>
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding ResultCaption}" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="参考图" FontSize="12" Foreground="#687B86" />
                                <Border Grid.Row="1" Background="#F2F5F7" CornerRadius="5">
                                    <Grid><TextBlock Text="暂无可显示图像" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8899A2" /><Image Source="{Binding ReferenceImage}" Stretch="Uniform" /></Grid>
                                </Border>
                            </Grid>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="26" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <TextBlock Text="待检图与缺陷区域" FontSize="12" Foreground="#687B86" />
                                <Border Grid.Row="1" Background="#F2F5F7" CornerRadius="5">
                                    <Grid>
                                        <TextBlock Text="暂无可显示图像" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8899A2" />
                                        <Viewbox Stretch="Uniform">
                                            <Grid Width="640" Height="640">
                                                <Image Source="{Binding TestedImage}" Stretch="Fill" />
                                                <ItemsControl ItemsSource="{Binding DefectOverlays}">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}" /><Setter Property="Canvas.Top" Value="{Binding Top}" /></Style></ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate><DataTemplate><Rectangle Width="{Binding Width}" Height="{Binding Height}" Stroke="#E84142" StrokeThickness="3" /></DataTemplate></ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="{Binding InspectionId}" FontFamily="Consolas" FontSize="11" Foreground="#8899A2" Margin="0,10,0,0" />
                    </Grid>
                </Border>
                <Border Grid.Row="4" Style="{StaticResource Card}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="查看选中档案" Command="{Binding ViewHistoryCommand}" Padding="10,4" FontSize="11" />
                            <TextBlock Text="最近检测档案" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEF1F3"
                                  Background="White" BorderThickness="0" RowHeight="28" FontSize="11" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="70" />
                                <DataGridTextColumn Header="产品编号" Binding="{Binding Product}" Width="*" />
                                <DataGridTextColumn Header="用途" Binding="{Binding Purpose}" Width="75" />
                                <DataGridTextColumn Header="样本" Binding="{Binding Sample}" Width="80" />
                                <DataGridTextColumn Header="执行" Binding="{Binding Execution}" Width="80" />
                                <DataGridTextColumn Header="判定" Binding="{Binding Decision}" Width="65" />
                                <DataGridTextColumn Header="区域" Binding="{Binding Defects}" Width="50" />
                                <DataGridTextColumn Header="同步" Binding="{Binding Upload}" Width="85" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
