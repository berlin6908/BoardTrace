<Window x:Class="BoardTrace.Station.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BoardTrace · 操作员登录" Width="430" Height="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#F2F5F7" FontFamily="Microsoft YaHei UI" Foreground="#203342">
    <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
      <Border Margin="24" Style="{StaticResource Card}" Padding="26">
        <StackPanel>
            <TextBlock Text="BoardTrace" FontSize="26" FontWeight="SemiBold" Foreground="#087F82" />
            <TextBlock x:Name="StationLabel" FontSize="13" Margin="0,8,0,24" />
            <TextBlock Text="人员账号" Margin="0,0,0,7" />
            <TextBox x:Name="UserNameInput" AutomationProperties.Name="人员账号" />
            <TextBlock Text="密码" Margin="0,18,0,7" />
            <PasswordBox x:Name="PasswordInput" Padding="9" BorderBrush="#CBD5DB" BorderThickness="1"
                         AutomationProperties.Name="人员密码" />
            <Button x:Name="LoginButton" Content="登录工位" IsDefault="True" Click="LoginButton_Click"
                    Background="#087F82" Foreground="White" Margin="0,22,0,0" />
            <TextBlock x:Name="Feedback" Text="需要操作员权限。登录后记录每次检测的操作人员。"
                       TextWrapping="Wrap" Foreground="#647B89" FontSize="12" Margin="0,16,0,0" />
        </StackPanel>
      </Border>
    </Grid>
</Window>
